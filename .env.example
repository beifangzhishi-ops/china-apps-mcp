# Local bind only. Keep this on 127.0.0.1; Tailscale Funnel provides HTTPS.
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Authentication mode: none | token | oauth
# - none: temporary PoC only; never use with account cookies or write tools.
# - token: static Bearer token for scripts/local debugging.
# - oauth: recommended for ChatGPT Custom MCP.
MCP_AUTH_MODE=none

# Static Bearer token used only when MCP_AUTH_MODE=token.
MCP_ACCESS_TOKEN=

# Public origin used by OAuth discovery, for example:
# https://your-node.your-tailnet.ts.net
# Do not include /mcp or a trailing slash.
MCP_PUBLIC_BASE_URL=

# Secret shown only to the human on the OAuth approval page.
# Keep it private; do not paste it into ChatGPT.
MCP_OAUTH_APPROVAL_SECRET=

# OAuth clients/tokens persist here so ChatGPT survives gateway restarts.
# This path is ignored by git.
MCP_OAUTH_STATE_FILE=.state/oauth-state.json

# Comma-separated Funnel hostnames only, without the scheme or path.
MCP_ALLOWED_HOSTS=

# Optional comma-separated Origin values when a client sends an Origin header.
MCP_ALLOWED_ORIGINS=

# Optional Bilibili browser cookie for account-only read tools.
BILIBILI_COOKIE=

# Edge browser bridge. When enabled, the gateway listens only on 127.0.0.1:8766
# for the unpacked Edge extension in edge-extension/. No browser launch flags,
# CDP port, browser profile, or Playwright runtime are used.
BROWSER_ENABLED=0

# Optional extra comma-separated hosts accepted by the MCP-side allowlist.
# The Edge extension has its own fixed host permissions; adding a host here does
# not automatically grant the extension permission to read that site.
BROWSER_ALLOWED_HOSTS=
