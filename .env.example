# Local bind only. Keep this on 127.0.0.1; Tailscale Funnel provides HTTPS.
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Optional bearer token for the /mcp endpoint.
# Generate a high-entropy value with scripts/init-env.ps1.
MCP_ACCESS_TOKEN=

# Optional Bilibili browser cookie for account-only read tools.
# Do not commit a real value. Leave empty for the public-video PoC.
BILIBILI_COOKIE=
